    {
      "parameters": {
        "jsCode": "const x=$json;\nlet t=String(x.source?.tekst_ishodnyy??'');\nconst known=Array.isArray(x.lokalnye_pii?.sootvetstviya)?x.lokalnye_pii.sootvetstviya:[];\nconst used=new Set(known.map(z=>String(z.psevdometka||'')));\nconst maps=[];\nfunction esc(s){return String(s).replace(/[-/\\^$*+?.()|[\\]{}]/g,'\\\\$&')}\nfor(const z of known){const v=z?.znachenie_zashchishchennoe,p=z?.psevdometka;if(v&&p)t=t.replace(new RegExp(esc(v),'gi'),p)}\nfunction next(prefix,tip,val,extra={}){let n=1,p;do{p=prefix+'_'+String(n++).padStart(2,'0')}while(used.has(p));used.add(p);maps.push({tip_pii:tip,psevdometka:p,znachenie_zashchishchennoe:String(val),...extra});return p}\nt=t.replace(/\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi,m=>next('EMAIL','email',m));\nt=t.replace(/(?<!\\w)(?:\\+?\\d[\\d\\s().-]{8,}\\d)(?!\\w)/g,m=>next('PHONE','telefon',m,{region_telefona:'RU'}));\nt=t.replace(/(?<!\\w)@[A-Za-z0-9_]{5,32}\\b/g,m=>next('USERNAME','telegram_username',m));\nt=t.replace(/\\b(меня\\s+зовут|мо[её]\\s+имя)\\s+([А-ЯЁA-Z][А-ЯЁA-Za-zа-яё-]{1,40})/gi,(m,p,n)=>p+' '+next('PERSON','imya',n));\nconst safe=t.trim();\nreturn [{json:{job:x.job,source:x.source,ai_kontekst:x.ai_kontekst,tekst_bez_pii:safe,db_pii:{\n operaciya_id:'pii:'+x.source.soobshchenie_id,\n soobshchenie_id:x.source.soobshchenie_id,\n tekst_obezlichennyy:safe,\n sootvetstviya:maps,\n region_telefona:'RU'\n}}}];"
      },

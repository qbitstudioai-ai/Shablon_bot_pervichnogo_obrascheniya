      "parameters": {
        "jsCode": "const root=$json||{},cfg=root._nastroyki_vhoda,body=root.body||{};\nconst m=body.message||body.edited_message||null,cb=body.callback_query||null;\nconst updateId=body.update_id;if(updateId===undefined||updateId===null)throw new Error('Нет Telegram update_id');\nlet chatId=null,fromId=null,messageId=null,sourceDate=null,eventType='message',messageType='system',text='',fileId=null,callbackData=null;\nif(m){chatId=m.chat?.id??null;fromId=m.from?.id??null;messageId=m.message_id??null;sourceDate=m.date?new Date(Number(m.date)*1000).toISOString():null;\nif(typeof m.text==='string'){messageType='text';text=m.text;}else if(m.voice){messageType='voice';fileId=m.voice.file_id??null;}else if(m.photo){messageType='photo';fileId=m.photo.at(-1)?.file_id??null;text=m.caption||'';}else if(m.video){messageType='video';fileId=m.video.file_id??null;text=m.caption||'';}else if(m.document){messageType='document';fileId=m.document.file_id??null;text=m.caption||'';}else if(m.sticker){messageType='sticker';fileId=m.sticker.file_id??null;}}\nelse if(cb){eventType='callback';callbackData=String(cb.data||'');chatId=cb.message?.chat?.id??null;fromId=cb.from?.id??null;messageId=cb.message?.message_id??null;sourceDate=cb.message?.date?new Date(Number(cb.message.date)*1000).toISOString():null;if(callbackData==='media_take'){messageType='text';text='Позвать менеджера';}else if(callbackData==='media_no'){messageType='text';text='Продолжить без менеджера';}}\nif(chatId===null||fromId===null)throw new Error('Не удалось определить chat_id/from_id');\nconst fp=['fp1',String(updateId),String(chatId),String(fromId),String(messageId??''),eventType,messageType,text,String(fileId??''),String(callbackData??'')].join('|');\nconst ingress={versiya_formata:1,operaciya_id:'tg_client_ingress:'+cfg.akkaunt_kanala_id+':'+updateId,klyuch_idempotentnosti:'telegram:'+cfg.akkaunt_kanala_id+':update:'+updateId,hash_soderzhaniya:fp,kanal:cfg.kanal,akkaunt_kanala_id:cfg.akkaunt_kanala_id,vneshnee_sobytie_id:String(updateId),vneshniy_polzovatel_id:String(fromId),vneshniy_dialog_id:String(chatId),vneshnee_soobshchenie_id:messageId===null?null:String(messageId),tip_sobytiya:eventType,tip_soobshcheniya:messageType,tekst_ishodnyy:text,vremya_istochnika:sourceDate,vremya_priema:new Date().toISOString(),trassirovka_id:'telegram:'+updateId,versiya_workflow:cfg.versiya_workflow,versiya_prompta:cfg.versiya_prompta,payload_ishodnyy:body,sluzhebnyy_chat_id:cfg.sluzhebnyy_chat_id,bezopasnaya_podpis_klienta:'Клиент •••'+String(fromId).slice(-4),nachalnyy_etap:cfg.nachalnyy_etap,prioritet:cfg.prioritet};\nreturn [{json:{db_ingress:ingress}}];"
